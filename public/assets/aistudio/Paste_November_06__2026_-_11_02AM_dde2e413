        ];

        // 2. BDI-II AUTHENTIC CRITICAL ITEMS WITH ACCURATE COMPLETE ORIGINAL STATEMENTS (0-3 Points Structure)
        const BDI2_QUESTIONS = [
            {
                id: 'bdi_1',
                text: 'الحزن والمزاج المنخفض الكئيب:',
                choices: [
                    'لا أشعر بالحزن. (0)',
                    'أشعر بالحزن معظم الوقت. (1)',
                    'أنا حزين طوال الوقت ولا أستطيع التخلص من حزني ومزاجي السيء. (2)',
                    'أنا حزين لدرجة أنني لا أستطيع تحمل حزني على الإطلاق. (3)'
