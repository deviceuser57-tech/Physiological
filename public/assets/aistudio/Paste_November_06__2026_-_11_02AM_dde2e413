    <script>
        // 1. PHQ-9 FULL STANDARD CRITERIA
        const PHQ9_QUESTIONS = [
            { id: 'phq_1', text: 'قلة الاهتمام أو المتعة في القيام بالأشياء المعتادة.', choices: ['أبداً', 'لعدة أيام', 'أكثر من نصف الأيام', 'تقريباً كل يوم'] },
            { id: 'phq_2', text: 'الشعور بالحزن أو الاكتئاب أو اليأس أو المزاج المنخفض.', choices: ['أبداً', 'لعدة أيام', 'أكثر من نصف الأيام', 'تقريباً كل يوم'] },
            { id: 'phq_3', text: 'صعوبة في الخلود إلى النوم، أو الاستيقاظ المتكرر، أو النوم المفرط الطويل.', choices: ['أبداً', 'لعدة أيام', 'أكثر من نصف الأيام', 'تقريباً كل يوم'] },

            { id: 'phq_4', text: 'الشعور بالتعب والإنهاك السريع، أو قلة طاقة الجسم العامة.', choices: ['أبداً', 'لعدة أيام', 'أكثر من نصف الأيام', 'تقريباً كل يوم'] },
            { id: 'phq_5', text: 'ضعف الشهية للطعام أو الشراهة والإفراط البديل والزيادة في الأكل.', choices: ['أبداً', 'لعدة أيام', 'أكثر من نصف الأيام', 'تقريباً كل يوم'] },
            { id: 'phq_6', text: 'الشعور بالسوء تجاه نفسك، أو أنك شخص فاشل، أو خيبت أمل نفسك أو عائلتك والمحيطين بك.', choices: ['أبداً', 'لعدة أيام', 'أكثر من نصف الأيام', 'تقريباً كل يوم'] },
            { id: 'phq_7', text: 'صعوبة شديدة في التركيز على الأشياء الاعتيادية، مثل قراءة الكتب أو الصحف أو مشاهدة التلفزيون أو العمل.', choices: ['أبداً', 'لعدة أيام', 'أكثر من نصف الأيام', 'تقريباً كل يوم'] },
            { id: 'phq_8', text: 'بطء ملحوظ في الحركة أو التحدث لدرجة تلاحظ من الآخرين، أو العكس: التململ والاضطراب الشديد وصعوبة الاستقرار حركياً في مكانك.', choices: ['أبداً', 'لعدة أيام', 'أكثر من نصف الأيام', 'تقريباً كل يوم'] },
