            { id: 'gds_7', text: 'هل تشعر بالسعادة والبهجة الداخلية والرضا في معظم أوقاتك؟', choices: ['نعم', 'لا'], reverse: true },
            { id: 'gds_8', text: 'هل تشعر بالعجز وقلة الحيلة أو الهوان والضعف غالباً؟', choices: ['نعم', 'لا'] },
            { id: 'gds_9', text: 'هل تفضل دائماً البقاء في غرفتك/منزلك على الخروج والقيام بأعمال جديدة؟', choices: ['نعم', 'لا'] },
            { id: 'gds_10', text: 'هل تشعر أن لديك مشاكل وضعف في الذاكرة والتركيز أكثر من الآخرين؟', choices: ['نعم', 'لا'] },
            { id: 'gds_11', text: 'هل تعتقد وتستشعر أنه من الرائع والمبهج أنك على قيد الحياة الآن؟', choices: ['نعم', 'لا'], reverse: true },
            { id: 'gds_12', text: 'هل تشعر بأنك بلا قيمة، أو بلا فائدة تذكر، أو عالة بالوضع الحالي؟', choices: ['نعم', 'لا'] },
            { id: 'gds_13', text: 'هل تشعر بالطاقة، والنشاط، والحيوية المفعمة المتجددة بدب في أوصالك؟', choices: ['نعم', 'لا'], reverse: true },
            { id: 'gds_14', text: 'هل تشعر وتظن بأن وضعك وظروفك الحالية تفتقر تماماً للأمل ومسدودة؟', choices: ['نعم', 'لا'] },
            { id: 'gds_15', text: 'هل تعتقد أو تظن أن معظم الناس المحيطين بك هم في وضع أفضل منك بكثير؟', choices: ['نعم', 'لا'] }
        ];


        // Global Application Architecture State Engine
        let activeScaleIndex = 0; 
        let currentQuestionPointer = 0;
        let scaleSequences = []; 
        let userResponses = {}; 
        let radarChartInstance = null;

        document.addEventListener("DOMContentLoaded", () => {
            startWizard();
        });

        function startWizard() {
            rebuildScaleSequences();
            renderStepTabs();
            gotoScaleIndex(0);
        }

        function rebuildScaleSequences() {
            scaleSequences = [

                { type: 'demographics', title: 'السياق والديموغرافيا', questions: [] },
                { type: 'phq9', title: 'مقياس PHQ-9 السريري', questions: PHQ9_QUESTIONS },
                { type: 'bdi2', title: 'مقياس بيك BDI-II المعرفي', questions: BDI2_QUESTIONS }
            ];

            if (document.getElementById('use-dass').checked) {
                scaleSequences.push({ type: 'dass21', title: 'مقياس DASS-21 للأعراض', questions: DASS21_QUESTIONS });
            }
            if (document.getElementById('use-gds').checked) {
                scaleSequences.push({ type: 'gds15', title: 'مقياس GDS-15 الشامل', questions: GDS15_QUESTIONS });
            }

            scaleSequences.push({ type: 'dashboard', title: 'تقرير التشخيص', questions: [] });
        }

        function renderStepTabs() {
            const container = document.getElementById('step-indicators');
            container.innerHTML = '';
            scaleSequences.forEach((sec, idx) => {

                const tab = document.createElement('div');
                tab.className = `flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-bold whitespace-nowrap opacity-40 transition-all`;
                tab.id = `tab-indicator-${idx}`;
                tab.innerHTML = `<span class="w-5 h-5 rounded-md flex items-center justify-center bg-white/10 font-mono text-[10px]">${idx + 1}</span> ${sec.title}`;
                container.appendChild(tab);
            });
        }

        function gotoScaleIndex(index) {
            activeScaleIndex = index;
            currentQuestionPointer = 0;

            scaleSequences.forEach((_, idx) => {
                const tab = document.getElementById(`tab-indicator-${idx}`);
                if (tab) {
                    if (idx === activeScaleIndex) {
                        tab.classList.remove('opacity-40');
                        tab.classList.add('opacity-100', 'bg-purple-600/20', 'border', 'border-purple-500/30', 'text-purple-400');
                    } else {

                        tab.className = "flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-bold whitespace-nowrap opacity-40 text-slate-400";
                    }
                }
            });

            document.getElementById('demographics-form').classList.add('hidden');
            document.getElementById('question-container').classList.add('hidden');
            document.getElementById('dashboard-view').classList.add('hidden');
            document.getElementById('info-bar').classList.add('hidden');

            const currentScale = scaleSequences[activeScaleIndex];

            if (currentScale.type === 'demographics') {
                document.getElementById('demographics-form').classList.remove('hidden');
                document.getElementById('btn-prev').classList.add('hidden');
                document.getElementById('btn-next').innerHTML = `حفظ والانتقال للأسئلة <i class="fa-solid fa-arrow-left ml-1"></i>`;
            } else if (currentScale.type === 'dashboard') {
                document.getElementById('dashboard-view').classList.remove('hidden');
                document.getElementById('btn-prev').classList.add('hidden');

                document.getElementById('btn-next').innerHTML = `إجراء فحص جديد <i class="fa-solid fa-rotate-right ml-1"></i>`;
                executeContextualCalculations();
            } else {
                document.getElementById('question-container').classList.remove('hidden');
                document.getElementById('info-bar').classList.remove('hidden');
                document.getElementById('btn-prev').classList.remove('hidden');
                document.getElementById('btn-next').innerHTML = `السؤال التالي <i class="fa-solid fa-arrow-left ml-1"></i>`;
                renderCurrentQuestion();
            }

            gsap.fromTo("#wizard-body", { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.25 });
        }

        function renderCurrentQuestion() {
            const currentScale = scaleSequences[activeScaleIndex];
            const q = currentScale.questions[currentQuestionPointer];

            document.getElementById('current-scale-title').innerText = currentScale.title;
            document.getElementById('current-step-progress').innerText = `السؤال ${currentQuestionPointer + 1} من ${currentScale.questions.length}`;


            const qContainer = document.getElementById('question-container');
            qContainer.innerHTML = '';

            const card = document.createElement('div');
            card.className = "p-6 rounded-2xl bg-white/5 border border-white/5 space-y-4";
            card.innerHTML = `
                <div class="flex justify-between items-start gap-4">
                    <h4 class="text-white font-medium text-base sm:text-lg leading-relaxed">${currentQuestionPointer + 1}. ${q.text}</h4>
                    <span class="text-[10px] bg-purple-500/10 text-purple-400 border border-purple-500/20 px-2 py-0.5 rounded font-mono uppercase tracking-wider">${currentScale.type}</span>
                </div>
                <div class="grid gap-2.5" id="options-box"></div>
            `;
            qContainer.appendChild(card);

            const optionsBox = card.querySelector('#options-box');
            const savedValue = userResponses[q.id] !== undefined ? userResponses[q.id] : null;

            q.choices.forEach((choice, scoreIdx) => {
                const label = document.createElement('label');

                label.className = "option-btn cursor-pointer block";
                
                let explicitPoints = scoreIdx;
                if (currentScale.type === 'gds15') {
                    if (q.reverse) {
                        explicitPoints = (scoreIdx === 1) ? 1 : 0; 
                    } else {
                        explicitPoints = (scoreIdx === 0) ? 1 : 0; 
                    }
                }

                label.innerHTML = `
                    <input type="radio" name="${q.id}" value="${scoreIdx}" ${savedValue === scoreIdx ? 'checked' : ''} class="option-input hidden" onchange="saveResponse('${q.id}', ${scoreIdx})">
                    <div class="option-ui p-3.5 bg-white/5 border border-white/10 rounded-xl text-right text-xs sm:text-sm text-slate-300 hover:bg-white/10 transition flex items-center justify-between">
                        <span>${choice}</span>
                        <span class="text-[10px] font-mono text-slate-500">الوزن العيادي للبديل: ${explicitPoints}ن</span>
                    </div>
                `;
                optionsBox.appendChild(label);

            });
        }

        function saveResponse(qId, scoreIdx) {
            userResponses[qId] = scoreIdx;
        }

        function handleNext() {
            const currentScale = scaleSequences[activeScaleIndex];

            if (currentScale.type === 'demographics') {
                const district = document.getElementById('d-district').value.trim();
                const city = document.getElementById('d-city').value.trim();
                if(!district || !city) {
                    alert('يرجى كتابة معايير المدينة والمنطقة بدقة لتنشيط محرك المعايرة والوزن المرجعي.');
                    return;
                }
                rebuildScaleSequences();
                renderStepTabs();

                gotoScaleIndex(1);
            } else if (currentScale.type === 'dashboard') {
                userResponses = {};
                gotoScaleIndex(0);
            } else {
                const currentQ = currentScale.questions[currentQuestionPointer];
                if (userResponses[currentQ.id] === undefined) {
                    alert('يرجى تحديد البديل السلوكي الأقرب لحالتك للمتابعة بشكل طبيعي.');
                    return;
                }

                if (currentQuestionPointer < currentScale.questions.length - 1) {
                    currentQuestionPointer++;
                    renderCurrentQuestion();
                    gsap.fromTo("#question-container", {opacity: 0, x: -8}, {opacity: 1, x: 0, duration: 0.15 });
                } else {
                    gotoScaleIndex(activeScaleIndex + 1);
                }
            }

        }

        function handlePrev() {
            if (currentQuestionPointer > 0) {
                currentQuestionPointer--;
                renderCurrentQuestion();
                gsap.fromTo("#question-container", {opacity: 0, x: 8}, {opacity: 1, x: 0, duration: 0.15 });
            } else {
                if (activeScaleIndex > 0) {
                    gotoScaleIndex(activeScaleIndex - 1);
                    const prevScale = scaleSequences[activeScaleIndex];
                    if (prevScale.questions.length > 0) {
                        currentQuestionPointer = prevScale.questions.length - 1;
                        renderCurrentQuestion();
                    }
                }
            }
        }


        // CONTEXTUAL STATISTICAL INTERPRETATION ENGINE
        function executeContextualCalculations() {
            let scoresMap = { phq9: 0, bdi2: 0, dass21: 0, gds15: 0 };
            
            PHQ9_QUESTIONS.forEach(q => scoresMap.phq9 += (userResponses[q.id] || 0));
            BDI2_QUESTIONS.forEach(q => scoresMap.bdi2 += (userResponses[q.id] || 0));
            DASS21_QUESTIONS.forEach(q => scoresMap.dass21 += (userResponses[q.id] || 0));
            
            GDS15_QUESTIONS.forEach(q => {
                const choiceIdx = userResponses[q.id] || 0;
                let calculatedScore = 0;
                if (q.reverse) {
                    calculatedScore = (choiceIdx === 1) ? 1 : 0; 
                } else {
                    calculatedScore = (choiceIdx === 0) ? 1 : 0; 
                }
                scoresMap.gds15 += calculatedScore;
            });


            let pPHQ = (scoresMap.phq9 / 27) * 100;
            let pBDI = (scoresMap.bdi2 / 63) * 100;
            let pDASS = document.getElementById('use-dass').checked ? (scoresMap.dass21 / 63) * 100 : 0;
            let pGDS = document.getElementById('use-gds').checked ? (scoresMap.gds15 / 15) * 100 : 0;

            // Environmental Weighting Modifier Evaluation
            let envModifier = 0;
            const age = parseInt(document.getElementById('d-age').value) || 28;
            const district = document.getElementById('d-district').value.trim();
            const city = document.getElementById('d-city').value.trim();
            const economy = document.getElementById('d-economy').value;
            const job = document.getElementById('d-job').value;
            const health = document.getElementById('d-health').value;

            if (district.includes("إمبابة") || district.includes("شبرا") || district.includes("عين شمس") || district.includes("مكتظ")) {
                envModifier += 15; 
            } else if (district.includes("المعادي") || district.includes("التجمع") || district.includes("الرحاب") || district.includes("زايد")) {
                envModifier -= 5;  
            }


            if (economy === 'stressful') envModifier += 15;
            if (job === 'unemployed') envModifier += 10;
            if (health === 'chronic' || health === 'acute') envModifier += 10;

            let activeCount = 2;
            if (document.getElementById('use-dass').checked) activeCount++;
            if (document.getElementById('use-gds').checked) activeCount++;

            let combinedBase = (pPHQ + pBDI + pDASS + pGDS) / activeCount;
            
            let finalCalibratedScore = combinedBase - (envModifier * 0.25);
            if (finalCalibratedScore < 0) finalCalibratedScore = 0;
            if (finalCalibratedScore > 100) finalCalibratedScore = 100;
            finalCalibratedScore = Math.round(finalCalibratedScore);

            document.getElementById('out-name').innerText = document.getElementById('d-name').value;
            document.getElementById('out-final-score').innerText = `${finalCalibratedScore}%`;
            document.getElementById('out-env-modifier').innerText = `${envModifier > 0 ? '+' : ''}${envModifier}%`;


            let severityLabel = "";
            let recommendation = "";

            if (finalCalibratedScore <= 20) {
                severityLabel = "أعراض طبيعية اعتيادية / غياب مؤشرات اضطراب الاكتئاب السريري";
                recommendation = "استمر في ممارسة الأنشطة اليومية وتعزيز الممارسات الوقائية والروابط الاجتماعية.";
            } else if (finalCalibratedScore <= 55) {
                severityLabel = "مؤشرات أعراض خفيفة إلى متوسطة (استجابة تكيفية للضغوط)";
                recommendation = "ينصح باستشارة إرشادية وتخفيف وطأة الإجهاد البيئي، والعملي، والمادي المحيط لتجنب تفاقم العوارض.";
            } else {
                severityLabel = "مؤشرات عوارض شديدة تستدعي فحصاً طبياً فورياً";
                recommendation = "ننصحك بشكل جاد بضرورة الترتيب لموعد تقييم سريري مباشر لدى طبيب أو أخصائي نفسي مؤهل لبدء بروتوكول الرعاية السليمة.";
            }

            document.getElementById('out-severity-label').innerText = severityLabel;
            document.getElementById('out-rec').innerText = recommendation;

            // Generate Narrative
            document.getElementById('out-narrative').innerHTML = `

                بناءً على المراجعة الدقيقة لكافة بنود وبدائل المقاييس الطبية الأربعة دون اختزال، بلغت نسبة الأعراض الكلية الموزونة لديك <strong>${finalCalibratedScore}%</strong>. 
                وعند قراءة الفحص في ضوء بيئتك الحالية في حي <strong>(${district} - ${city})</strong>، تم رصد معامل ضغوط بيئية واقتصادية وصحية بمقدار <strong>${envModifier}%</strong>. 
                توضح هذه المعايرة الإحصائية أن قسماً معتبراً من العوارض المعرفية والجسدية (مثل اضطرابات النوم، لوم الذات، ونقص الطاقة البدنية) قد يمثل رد فعل استجابي تكيفي طبيعي تجاه الإجهاد المادي، ضغوط العمل، والكثافة السكنية المحيطة بك، وليس بالضرورة اضطراباً بيولوجياً داخلي المنشأ بالكامل، مما يستلزم التركيز على تعديل منغصات نمط الحياة والحد من المجهود العصبي المستمر.
            `;

            renderRadarChart(pPHQ, pBDI, pDASS, pGDS);
        }

        function renderRadarChart(phq, bdi, dass, gds) {
            if (radarChartInstance) {
                radarChartInstance.destroy();
            }

            const ctx = document.getElementById('radarChart').getContext('2d');
            radarChartInstance = new Chart(ctx, {
                type: 'radar',
                data: {
                    labels: ['السريري PHQ-9', 'المعرفي BDI-II', 'التوتر DASS-21', 'الرضا العام GDS-15'],
                    datasets: [{

                        label: 'الدرجة المئوية الفعلية للقسم',
                        data: [Math.round(phq), Math.round(bdi), Math.round(dass), Math.round(gds)],
                        backgroundColor: 'rgba(168, 85, 247, 0.15)',
                        borderColor: 'rgba(168, 85, 247, 0.85)',
                        borderWidth: 2,
                        pointBackgroundColor: '#6366f1',
                        pointBorderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    scales: {
                        r: {
                            angleLines: { color: 'rgba(255, 255, 255, 0.08)' },
                            grid: { color: 'rgba(255, 255, 255, 0.08)' },
                            pointLabels: { color: '#94a3b8', font: { family: 'Cairo', size: 10, weight: 'bold' } },
                            ticks: { display: false },
                            min: 0,

                            max: 100
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        }
    </script>
</body>
</html>


